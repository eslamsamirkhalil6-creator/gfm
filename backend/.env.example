# GFMS Backend Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Local Windows PostgreSQL instance or Docker container)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gfms_db

# Security & JSON Web Token
JWT_SECRET=gfms_secure_secret_key_change_in_production_2026
JWT_EXPIRES_IN=8h

# CORS Allowed Origin for Frontend
CORS_ORIGIN=http://localhost:3000
