# GFMS Root Environment Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Connection String
# Leave empty to use in-memory PostgreSQL engine in AI Studio preview,
# or set to your local PostgreSQL instance on Windows:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gfms_db

# Security & JWT Authentication
JWT_SECRET=gfms_secure_secret_key_change_in_production_2026
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=*

# AI Studio runtime vars
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
